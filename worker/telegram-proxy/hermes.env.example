# Hermes gateway — cấu hình Telegram chạy chế độ WEBHOOK qua Worker proxy mỏng.
# Copy các dòng này vào ~/.hermes/.env (mode 600). KHÔNG commit giá trị thật.

# 1) Token bot MỚI từ @BotFather (token cũ đã bị revoke — tạo lại bằng /newbot).
TELEGRAM_BOT_TOKEN=123456789:AA...

# 2) Chỉ người dùng được phép nói chuyện (ID số, cách nhau dấu phẩy).
#    Lấy ID bằng @userinfobot.
TELEGRAM_ALLOWED_USERS=<user_id_cua_ban>

# 3) Webhook mode — trỏ về Worker proxy (KHÔNG trỏ thẳng vào tunnel/gateway).
#    Hermes sẽ tự gọi setWebhook với URL này + secret bên dưới.
TELEGRAM_WEBHOOK_URL=https://<worker>.workers.dev/telegram

# 4) Secret xác thực update. PHẢI GIỐNG HỆT giá trị WEBHOOK_SECRET đã đặt ở Worker.
#    Tạo bằng: openssl rand -hex 32  → dán vào cả 2 nơi.
TELEGRAM_WEBHOOK_SECRET=<cung_secret_voi_worker>

# 5) Cổng webhook server Hermes lắng nghe (mặc định 8443).
TELEGRAM_WEBHOOK_PORT=8443

# (tùy chọn) Kênh nhận kết quả cron.
# TELEGRAM_HOME_CHANNEL=<chat_id>
